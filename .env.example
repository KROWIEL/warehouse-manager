# ==== Store Manager ====
# Скопируйте этот файл в .env и поменяйте значения под себя.

# ==== Публикация на сервере с доменом (HTTPS через Caddy) ====
# Домен, на который указывает A-запись сервера (без http/https)
DOMAIN=store.example.com
# Email для Let's Encrypt (уведомления об истечении сертификата)
ACME_EMAIL=admin@example.com
# true на проде (только https), false для локального запуска по http
COOKIE_SECURE=true

# Сколько дней живёт сессия входа
SESSION_DAYS=30

# Сколько дней без продаж считать товар «мёртвым стоком» в статистике
DEAD_STOCK_DAYS=60

# ==== Аккаунты ====
# Регистрации нет: аккаунты создаются отсюда при первом запуске.
# Сколько блоков SEED_USER{N}_* укажете — столько аккаунтов и появится.
# Пароли ниже одноразовые: при первом входе приложение потребует сменить пароль
# на строгий (минимум 8 символов, заглавная, строчная и специальный символ).
# Уже созданные аккаунты при перезапуске не пересоздаются и пароли не сбрасываются.
SEED_USER1_USERNAME=ivan
SEED_USER1_NAME=Иван
SEED_USER1_PASSWORD=change-me-1
SEED_USER1_AVATAR=fox

SEED_USER2_USERNAME=maria
SEED_USER2_NAME=Мария
SEED_USER2_PASSWORD=change-me-2
SEED_USER2_AVATAR=cat

# Доступные аватары: fox cat dog owl bear panda penguin koala lion tiger rabbit
# hamster mouse frog monkey chick unicorn dragon wolf hedgehog pig cow elephant
# octopus whale turtle butterfly parrot deer raccoon crab dolphin
